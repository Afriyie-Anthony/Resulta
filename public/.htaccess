# Resulta single-page application routing
Options -MultiViews
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve existing files normally.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Serve pre-rendered pages (e.g. /purchase/wassce -> /purchase/wassce/index.html)
  # without a trailing-slash redirect, so URLs match their canonical tags.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*?)/?$ $1/index.html [L]

  # Let React Router handle direct visits and browser refreshes.
  RewriteRule ^ index.html [L]
</IfModule>
