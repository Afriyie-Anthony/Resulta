# =============================================================================
# Resulta — LOCAL SECRETS
# =============================================================================
# ⚠️  This file is gitignored — NEVER commit this to version control.
# Fill in your real API keys below.
# =============================================================================


# -----------------------------------------------------------------------------
# CORE API
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=https://api.resultagh.com/api/v1
# VITE_API_BASE_URL=https://resulta-backend.onrender.com/api/v1
VITE_APP_ENV=development


# -----------------------------------------------------------------------------
# HUBTEL — Payment Gateway & SMS
# Get keys from: https://merchants.hubtel.com > Settings > API Credentials
# -----------------------------------------------------------------------------
VITE_HUBTEL_API_URL=https://api.hubtel.com
VITE_HUBTEL_CLIENT_ID=REPLACE_WITH_YOUR_HUBTEL_CLIENT_ID
VITE_HUBTEL_CLIENT_SECRET=REPLACE_WITH_YOUR_HUBTEL_CLIENT_SECRET
VITE_HUBTEL_MERCHANT_ACCOUNT=REPLACE_WITH_YOUR_MERCHANT_ACCOUNT_NUMBER
VITE_HUBTEL_CALLBACK_URL=https://resulta-backend.onrender.com/api/v1/payments/hubtel/callback
VITE_HUBTEL_SMS_SENDER_ID=RESULTA


# -----------------------------------------------------------------------------
# ARKESEL — SMS Gateway
# Get key from: https://arkesel.com > Dashboard > API Keys
# -----------------------------------------------------------------------------
VITE_ARKESEL_API_KEY=REPLACE_WITH_YOUR_ARKESEL_API_KEY
VITE_ARKESEL_API_URL=https://sms.arkesel.com/api/v2
VITE_ARKESEL_SENDER_ID=RESULTA


# -----------------------------------------------------------------------------
# USSD
# -----------------------------------------------------------------------------
VITE_USSD_SHORTCODE=*713*5912#
VITE_USSD_SERVICE_CODE=5912


# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
VITE_FEATURE_USSD_ENABLED=true
VITE_FEATURE_BULK_PURCHASE=true
VITE_FEATURE_AFFILIATE_PORTAL=true
VITE_FEATURE_MAINTENANCE_MODE=false
