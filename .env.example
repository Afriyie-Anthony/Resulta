# =============================================================================
# Resulta — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# All Vite env vars must be prefixed with VITE_ to be exposed to the browser.
# Backend-only secrets (without VITE_ prefix) are kept here for documentation
# but must be configured on the server — they are NOT accessible in the browser.
# =============================================================================


# -----------------------------------------------------------------------------
# CORE API
# -----------------------------------------------------------------------------
# Base URL of the Resulta backend API (no trailing slash)
VITE_API_BASE_URL=https://resulta-backend.onrender.com/api/v1

# App environment (development | staging | production)
VITE_APP_ENV=development


# -----------------------------------------------------------------------------
# HUBTEL — Payment Gateway & SMS
# Docs: https://developers.hubtel.com
# Used for: MoMo payment collection + transactional SMS delivery
# -----------------------------------------------------------------------------
# Hubtel API base URL
VITE_HUBTEL_API_URL=https://api.hubtel.com

# Hubtel Client ID (from Hubtel Merchant Account > API Credentials)
VITE_HUBTEL_CLIENT_ID=your-hubtel-client-id

# Hubtel Client Secret (from Hubtel Merchant Account > API Credentials)
# ⚠️  In production: store this on the backend only — never expose to browser
VITE_HUBTEL_CLIENT_SECRET=your-hubtel-client-secret

# Hubtel Merchant Account Number
VITE_HUBTEL_MERCHANT_ACCOUNT=your-hubtel-merchant-account-number

# Hubtel Payment Callback URL (public URL the gateway posts results back to)
VITE_HUBTEL_CALLBACK_URL=https://resulta-backend.onrender.com/api/v1/payments/hubtel/callback

# Hubtel SMS Sender ID (NCA-registered alphanumeric)
VITE_HUBTEL_SMS_SENDER_ID=RESULTA


# -----------------------------------------------------------------------------
# ARKESEL — SMS Gateway
# Docs: https://developers.arkesel.com
# Used for: Bulk promotional SMS + fallback transactional delivery
# -----------------------------------------------------------------------------
# Arkesel API key (from Arkesel Dashboard > API Keys)
VITE_ARKESEL_API_KEY=your-arkesel-api-key

# Arkesel API base URL
VITE_ARKESEL_API_URL=https://sms.arkesel.com/api/v2

# Arkesel Sender ID (must match NCA-approved Sender ID)
VITE_ARKESEL_SENDER_ID=RESULTA


# -----------------------------------------------------------------------------
# USSD — Shortcode Configuration
# Used for: Feature phone USSD checkout channel (*713*5912#)
# -----------------------------------------------------------------------------
# Assigned USSD shortcode for the Resulta channel
VITE_USSD_SHORTCODE=*713*5912#

# USSD service code (service-level identifier within the shortcode)
VITE_USSD_SERVICE_CODE=5912


# -----------------------------------------------------------------------------
# MOMO DIRECT — Mobile Money API (MTN, Telecel, AirtelTigo)
# These are backend-only secrets — configured on the server, NOT the browser.
# Documented here for developer reference.
# -----------------------------------------------------------------------------
# MTN MoMo API (Ghana)
# MOMO_MTN_SUBSCRIPTION_KEY=your-mtn-momo-subscription-key
# MOMO_MTN_API_USER_ID=your-mtn-api-user-id
# MOMO_MTN_API_KEY=your-mtn-api-key
# MOMO_MTN_TARGET_ENV=production

# Telecel Cash API
# MOMO_TELECEL_API_KEY=your-telecel-api-key
# MOMO_TELECEL_MERCHANT_ID=your-telecel-merchant-id

# AirtelTigo Money API
# MOMO_AIRTELTIGO_CLIENT_ID=your-airteltigo-client-id
# MOMO_AIRTELTIGO_CLIENT_SECRET=your-airteltigo-client-secret


# -----------------------------------------------------------------------------
# JWT CONFIGURATION (Backend — for documentation reference only)
# These are server-side only. Configure on Render environment variables.
# -----------------------------------------------------------------------------
# JWT_SECRET=your-super-secret-jwt-signing-key-min-32-chars
# JWT_ACCESS_TOKEN_EXPIRES_IN=15m
# JWT_REFRESH_TOKEN_EXPIRES_IN=7d


# -----------------------------------------------------------------------------
# FEATURE FLAGS
# Toggle features without a code deployment
# -----------------------------------------------------------------------------
# Enable the USSD checkout channel
VITE_FEATURE_USSD_ENABLED=true

# Enable bulk voucher purchase (10+ at discounted rate)
VITE_FEATURE_BULK_PURCHASE=true

# Enable affiliate portal
VITE_FEATURE_AFFILIATE_PORTAL=true

# Maintenance mode — shows a "coming soon" banner on the storefront
VITE_FEATURE_MAINTENANCE_MODE=false
